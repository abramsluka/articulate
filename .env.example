# Copy to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored for a reason.

# ─── Supabase ────────────────────────────────────────────────
# URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS. Server-side only, never expose this.
# Used by the demo-reset cron and the create-demo-user script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI ──────────────────────────────────────────────────────
# OpenAI is used for Whisper transcription only.
OPENAI_API_KEY=

# Anthropic scores each recorded attempt.
ANTHROPIC_API_KEY=

# Per-user daily cap on AI operations, enforced in app/lib/rate-limit.ts.
AI_DAILY_OP_LIMIT=

# ─── Demo account ────────────────────────────────────────────
# A shared read-only account reachable via /demo. The nightly cron at
# /api/demo-reset wipes its sessions so it always starts clean.
DEMO_EMAIL=
DEMO_ACCESS_CODE=

# Bearer token the Vercel cron must present to POST /api/demo-reset.
# Generate with: openssl rand -hex 32
CRON_SECRET=
